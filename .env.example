# Local dev needs none of this — settings.py falls back to safe local
# defaults when these aren't set. On Render, set these in your service's
# Environment tab (Dashboard → your service → Environment).

# SECRET_KEY=                                  # generate a real one, see settings.py comment
# DEBUG=False                                  # set this now — currently defaults to True, unsafe on a public URL
# ALLOWED_HOSTS=travel-backend-bcty.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
# DATABASE_URL=postgres://...                  # set once you attach a Postgres instance (see settings.py comment on why this matters)
